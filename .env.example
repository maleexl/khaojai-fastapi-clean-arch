# App
APP_NAME=Khaojai FastAPI Clean Arch
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (async driver: postgresql+asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/khaojai

# JWT
JWT_SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
